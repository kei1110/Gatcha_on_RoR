# === macOS / エディタ ===
.DS_Store
*.swp
*~

# === Claude Code / MCP ランタイム（機械ローカル・コミット不要）===
# jp-labor-evidence MCP の法令インデックスキャッシュ
.jp-labor-evidence-indexes/
# 機械ローカルの Claude 設定（settings.json は共有）
.claude/settings.local.json
.playwright-mcp/
.sf/
.sfdx/

# === シークレット / 環境変数 ===
.env
.env.*
!.env.example

# ============================================================
# 以下は Ruby on Rails 8 標準の除外（rails new 後に有効化）。
# 先回りで定義。rails new が生成する .gitignore と重複時は要マージ。
# ============================================================

# Bundler
/.bundle
/vendor/bundle

# ログ・一時ファイル
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Active Storage（ローカル保存）
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# 認証情報の鍵（credentials の暗号文 .yml.enc はコミット可、鍵は除外）
/config/master.key
/config/credentials/*.key

# アセット・依存
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules/

# その他
.byebug_history
