<h2>パスワードの設定</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, "新しいパスワード" %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> 文字以上)</em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "新しいパスワード（確認）" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "パスワードを設定する" %>
  </div>
<% end %>

<%# shared/_links は controller_name == 'passwords' で recoverable リンクを出さないため、
    期限切れエラー再描画時の自己再設定導線をここで明示する（招待メール文面と同一文言） %>
<p class="mt-4 text-sm"><%= link_to "パスワードを忘れた方はこちら", new_password_path(resource_name) %></p>

<%= render "devise/shared/links" %>
