<nav class="mb-6 border-b border-gray-300">
  <ul class="flex gap-2">
    <% tabs.each do |label, path| %>
      <li>
        <%= link_to label, path,
              class: "inline-block px-4 py-2 #{helpers.current_page?(path) ? 'border-b-2 border-gray-800 font-bold' : 'text-gray-500'}" %>
      </li>
    <% end %>
  </ul>
</nav>
