{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/guard-git-identity.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/block-secrets.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/block-schema-edit.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/block-gemfile-lock-edit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/rubocop-autoformat.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/check-tenant-scope.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/check-job-tenant-wrap.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/regen-spec-index.sh" }
        ]
      }
    ]
  }
}
